config SHIELD_AVOCADO_LEFT
    def_bool $(shields_list_contains,avocado_left)

config SHIELD_AVOCADO_RIGHT
    def_bool $(shields_list_contains,avocado_right)


if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL
